# ---------------------------------------------------------------- shared
NETWORK=nile                       # nile | mainnet
LOG_LEVEL=info

# ---------------------------------------------------------------- core
DATABASE_URL=postgresql://usdt:usdt@localhost:5433/usdt_trx
REDIS_URL=redis://localhost:6380
PORT=3000
# Admin dev proxy target; change alongside PORT if 3000 is already in use.
CORE_URL=http://localhost:3000
RUN_WORKERS=true

# Admin login. First run: set SETUP_TOKEN (any 8+ characters), start the stack, open the admin UI — the setup page
# asks for this value once, then you pick username/password and scan a QR with your authenticator app.
SETUP_TOKEN=change-me-setup
# Alternative: static login in .env = password + 6-digit TOTP code (2FA is mandatory either way). 12+ chars.
# ADMIN_PASSWORD=
# Base32 TOTP secret for ADMIN_PASSWORD: `pnpm --filter @usdt-trx/core totp:setup` prints it + otpauth URI.
# ADMIN_TOTP_SECRET=
# Session lifetime after login (ms), default 12h
ADMIN_SESSION_TTL_MS=43200000
# Step-up 2FA: payouts, sweeps, staking, wallet and settings changes ask for a fresh code (optional, recommended)
ADMIN_TOTP_STEP_UP=false
# Only these IPs/CIDRs may call the admin API (login included). Empty = any. Behind a proxy set TRUST_PROXY=true.
# ADMIN_ALLOWED_IPS=203.0.113.10,10.0.0.0/8
# X-Forwarded-For trust: false (direct), 1 = one own proxy in front (nginx from this repo), or a list of proxy IPs/CIDRs.
# Never `true` on a reachable port: clients could forge their IP for the audit log, rate limiter and ADMIN_ALLOWED_IPS.
TRUST_PROXY=false
# Advanced: several credentials "token:role[:TOTPSECRET]" (viewer | operator | admin), comma separated.
# With a TOTP secret the entry is a login (password + code); without one it is a machine token for scripts
# (accepted as Bearer directly, no 2FA) — leave those out to force 2FA for everyone.
# ADMIN_TOKENS=

# TRON RPC endpoints in failover order (TronGrid, own node, ...)
TRON_RPC_URLS=https://nile.trongrid.io
TRONGRID_API_KEY=
# TronGrid history API for recovery scans (default follows NETWORK)
# TRONGRID_API_URL=
# Labels backup (address names, payout notes), rewritten on every change; keep it next to the seed backup
LABELS_FILE=./backup/labels.json
# USDT contract is derived from NETWORK; override only for tests
# USDT_CONTRACT=

# Optional external cold collector. Leave empty: sweeps then land on the main wallet derived from the phrase.
# If set, it must be the same in core and signer.
# COLLECTOR_ADDRESS=

SIGNER_URL=http://127.0.0.1:3100
SIGNER_TOKEN=change-me-at-least-32-characters-long-token
ADDRESS_POOL_SIZE=20
# TronLink-compatible layout (recommended when importing a phrase you already use in a wallet app): the address the
# app shows becomes the MAIN wallet, deposit addresses start at index 1. Both lines go together.
# MAIN_WALLET_PATH=m/44'/195'/0'/0/0
# ADDRESS_START_INDEX=1

# itrx.io energy rental (https://develop.itrx.io) — mainnet only
ITRX_API_KEY=
ITRX_API_SECRET=
ITRX_CALLBACK_URL=
ITRX_RENT_PERIOD=1H
# Auto top-up of the itrx prepaid balance from the pool wallet: set the deposit address from the itrx dashboard.
# Sends only what the next order needs (+2 TRX reserve), between 10 (itrx minimum) and 100 TRX per transfer.
# ITRX_DEPOSIT_ADDRESS=
# ITRX_TOPUP_RESERVE_SUN=2000000
# ITRX_TOPUP_MIN_SUN=10000000
# ITRX_TOPUP_MAX_SUN=100000000
ITRX_MIN_BALANCE_SUN=50000000

# Fee-paying pool wallet. By default derived from the wallet phrase (account 1) — leave empty. Override only with an external pool key.
# POOL_ADDRESS=
POOL_ACTIVATION_SUN=100000
POOL_BANDWIDTH_TOPUP_SUN=400000
BURN_ENABLED=false

# Sweep policy defaults (editable at runtime from the admin UI)
SWEEP_MIN_USDT=20
SWEEP_MAX_AGE_HOURS=72
MIN_DEPOSIT_USDT=0.01
FEE_LIMIT_SUN=15000000
ENERGY_MARGIN=1.1
ENERGY_DAILY_BUDGET_SUN=2000000000
SWEEP_MAX_PER_HOUR=200
PROVIDER_ORDER=itrx,own_pool,burn
LEAVE_DUST_ON_ADDRESS=false

# Watcher
# WATCHER_START_BLOCK=
WATCHER_BATCH_BLOCKS=20
# Check the chain head every 15 seconds; every intervening block is still scanned.
WATCHER_POLL_MS=15000
TX_TTL_MS=600000
CONFIRM_TIMEOUT_MS=900000
ENERGY_WAIT_MS=90000
SWEEP_MAX_ATTEMPTS=4

# ---------------------------------------------------------------- signer
SIGNER_HOST=127.0.0.1
SIGNER_PORT=3100
SEED_SOURCE=file                   # file | env (env only on nile)
SEED_FILE=./secrets/seed.enc.json
SEED_PASSPHRASE=                   # or SEED_PASSPHRASE_FILE=/run/secrets/seed-pass
# SEED_HEX=                        # nile dev only, with SEED_SOURCE=env
MAX_FEE_LIMIT_SUN=30000000
MAX_EXPIRATION_MS=900000
MAX_SWEEP_AMOUNT_RAW=0
POOL_KEY_SOURCE=none               # none = pool derived from the phrase | file | env (external pool key)
POOL_KEY_FILE=./secrets/pool.enc.json
POOL_KEY_PASSPHRASE=
POOL_MAX_TRANSFER_SUN=2000000
# Addresses the pool may pay more than POOL_MAX_TRANSFER_SUN to (put the itrx deposit address here), and that cap
# POOL_TRUSTED_RECIPIENTS=
POOL_MAX_TRUSTED_TRANSFER_SUN=100000000
POOL_MAX_DELEGATE_SUN=200000000000
AUDIT_LOG_PATH=./signer-audit.log

# ---------------------------------------------------------------- admin UI (build-time)
VITE_API_BASE=
