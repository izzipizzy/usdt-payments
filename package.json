{
  "name": "usdt-trx",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted USDT TRC-20 payment system: receiving addresses, deposit tracking, collection and payouts; isolated signer and web admin with 2FA",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "test": "pnpm -r --filter './packages/*' --filter './apps/*' test",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' typecheck",
    "lint": "pnpm -r --filter './packages/*' --filter './apps/*' lint",
    "dev:core": "pnpm --filter @usdt-trx/core dev",
    "dev:watcher": "pnpm --filter @usdt-trx/core dev:watcher",
    "dev:signer": "pnpm --filter @usdt-trx/signer dev",
    "dev:admin": "pnpm --filter @usdt-trx/admin dev",
    "db:migrate": "pnpm --filter @usdt-trx/core prisma:migrate",
    "db:generate": "pnpm --filter @usdt-trx/core prisma:generate"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp": "^8.4.0",
      "deepmerge-ts": "^8.0.0",
      "fastify": "^5.12.5"
    }
  }
}
